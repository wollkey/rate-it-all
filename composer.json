{
    "description": "Game Rate It All",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "ddd", "game", "rate-it-all"],
    "authors": [
        {
            "name": "Alisher Tashmatov",
            "email": "pirojok167@gmail.com",
            "homepage": "https://github.com/wollkey",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/wollkey/rate-it-all/issues",
        "source": "https://github.com/wollkey/rate-it-all"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "8.4.*",
        "doctrine/doctrine-bundle": "^3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phptg/bot-api": "*",
        "ramsey/uuid": "^4.9",
        "sentry/sentry-symfony": "^5.9",
        "symfony/console": "7.4.*",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "deptrac/deptrac": "4.4",
        "friendsofphp/php-cs-fixer": "^3.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "^7.4",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
